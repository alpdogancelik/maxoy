# Local database (Docker Postgres)
DATABASE_URL="postgresql://maxoy:maxoy@localhost:5432/maxoy?schema=public"

# Admin seed user (optional overrides)
ADMIN_EMAIL="admin@maxoy.local"
ADMIN_PASSWORD="ChangeMe123!"

# Media
# Default is local storage under public/uploads (good for local dev).
MEDIA_STORAGE="local"

# Optional: configure S3/R2 uploads (unset MEDIA_STORAGE or set it to "" and fill values below)
S3_ENDPOINT=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET=""
MEDIA_PUBLIC_BASE_URL=""
NEXT_PUBLIC_MEDIA_BASE_URL=""
