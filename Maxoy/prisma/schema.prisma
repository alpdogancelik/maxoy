// Prisma schema for admin + store data
// Uses PostgreSQL for production

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleName {
  ADMIN
  EDITOR
  ORDER_MANAGER
  VIEWER
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  RESTORE
  LOGIN
  LOGOUT
}

enum OrderStatus {
  PENDING
  PAID
  PREPARING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  WHATSAPP
  BANK_TRANSFER
}

enum PublishStatus {
  DRAFT
  PUBLISHED
}

model Role {
  id    String   @id @default(cuid())
  name  RoleName @unique
  users AdminUser[]
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  roleId       String
  role         Role     @relation(fields: [roleId], references: [id])
  isActive     Boolean  @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  sessions     Session[]
  auditLogs    AuditLog[]

  @@map("User")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      AdminUser @relation(fields: [userId], references: [id])
  token     String   @unique
  expiresAt DateTime
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())
}

model AuditLog {
  id         String      @id @default(cuid())
  actorId    String
  actor      AdminUser   @relation(fields: [actorId], references: [id])
  action     AuditAction
  entityType String
  entityId   String
  before     Json?
  after      Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())
}

model MediaAsset {
  id          String   @id @default(cuid())
  key         String   @unique
  url         String
  mime        String
  size        Int
  width       Int?
  height      Int?
  altText     String
  folder      String?
  blurDataUrl String?
  variants    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  categories     Category[]
  productMedia   ProductMedia[]
  heroSlides     HeroSlide[]
  categoryCards  CategoryCard[]
  orderReceipts  Order[]
}

model Category {
  id            String   @id @default(cuid())
  slug          String   @unique
  nameTR        String
  nameEN        String
  descriptionTR String?
  descriptionEN String?
  seoTitle      String?
  seoDesc       String?
  parentId      String?
  parent        Category? @relation("CategoryToCategory", fields: [parentId], references: [id])
  children      Category[] @relation("CategoryToCategory")
  imageAssetId  String?
  imageAsset    MediaAsset? @relation(fields: [imageAssetId], references: [id])
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?
  products      Product[]
}

model Product {
  id             String   @id @default(cuid())
  slug           String   @unique
  sku            String   @unique
  barcode        String?  @unique
  nameTR         String
  nameEN         String
  shortDescTR    String?
  shortDescEN    String?
  longDescTR     String?
  longDescEN     String?
  seoTitle       String?
  seoDesc        String?
  categoryId     String
  category       Category @relation(fields: [categoryId], references: [id])
  priceRetail    Decimal
  priceWholesale Decimal?
  priceVip       Decimal?
  discount       Decimal?
  stockQty       Int      @default(0)
  isActive       Boolean  @default(true)
  isFeatured     Boolean  @default(false)
  variantGroup   String?
  variantLabelTR String?
  variantLabelEN String?
  colorToneTR    String?
  colorToneEN    String?
  secondaryColorTR String?
  secondaryColorEN String?
  swatchPrimary  String?
  swatchSecondary String?
  variantSortOrder Int    @default(0)
  tags           String[]
  status         PublishStatus @default(DRAFT)
  publishedAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?
  media          ProductMedia[]
  featuredIn     HomeFeaturedProduct[]

  @@index([variantGroup])
}

model ProductMedia {
  id        String     @id @default(cuid())
  productId String
  product   Product    @relation(fields: [productId], references: [id])
  mediaId   String
  media     MediaAsset @relation(fields: [mediaId], references: [id])
  sortOrder Int        @default(0)

  @@unique([productId, mediaId])
}

model HomePage {
  id           String        @id @default(cuid())
  status       PublishStatus @default(DRAFT)
  publishedAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  announcements  Announcement[]
  heroSlides     HeroSlide[]
  categoryCards  CategoryCard[]
  featured       HomeFeaturedProduct[]
  trustBadges    TrustBadge[]
}

model Announcement {
  id         String   @id @default(cuid())
  homePageId String
  homePage   HomePage @relation(fields: [homePageId], references: [id])
  messageTR  String
  messageEN  String
  sortOrder  Int @default(0)
  isActive   Boolean @default(true)
}

model HeroSlide {
  id           String   @id @default(cuid())
  homePageId   String
  homePage     HomePage @relation(fields: [homePageId], references: [id])
  titleTR      String
  titleEN      String
  subtitleTR   String?
  subtitleEN   String?
  ctaTextTR    String?
  ctaTextEN    String?
  ctaLink      String?
  imageAssetId String
  imageAsset   MediaAsset @relation(fields: [imageAssetId], references: [id])
  sortOrder    Int @default(0)
  isActive     Boolean @default(true)
}

model CategoryCard {
  id            String   @id @default(cuid())
  homePageId    String
  homePage      HomePage @relation(fields: [homePageId], references: [id])
  titleTR       String
  titleEN       String
  descriptionTR String?
  descriptionEN String?
  link          String?
  themeColor    String?
  imageAssetId  String
  imageAsset    MediaAsset @relation(fields: [imageAssetId], references: [id])
  sortOrder     Int @default(0)
}

model HomeFeaturedProduct {
  id         String   @id @default(cuid())
  homePageId String
  homePage   HomePage @relation(fields: [homePageId], references: [id])
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  sortOrder  Int @default(0)
}

model TrustBadge {
  id         String   @id @default(cuid())
  homePageId String
  homePage   HomePage @relation(fields: [homePageId], references: [id])
  icon       String
  textTR     String
  textEN     String
  sortOrder  Int @default(0)
}

model CatalogPage {
  id         String        @id @default(cuid())
  key        String        @unique
  path       String        @unique
  status     PublishStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  sortOrder  Int           @default(0)
  navVisible Boolean       @default(false)

  titleTR    String
  titleEN    String
  seoTitleTR String?
  seoTitleEN String?
  seoDescTR  String?
  seoDescEN  String?

  initialMainCategory String?
  initialSubcategory  String?
  allowedMainCategories String[]
  allowedSubcategories  String[]
  sidebarItems Json?
}

model Settings {
  id        String  @id @default(cuid())
  data      Json
  updatedAt DateTime @updatedAt
}

model Order {
  id             String       @id @default(cuid())
  status         OrderStatus  @default(PENDING)
  paymentMethod  PaymentMethod
  customerInfoId String
  customerInfo   CustomerInfo @relation(fields: [customerInfoId], references: [id])
  addressId      String
  address        Address      @relation(fields: [addressId], references: [id])
  shippingNote   String?
  adminNote      String?
  receiptAssetId String?
  receiptAsset   MediaAsset? @relation(fields: [receiptAssetId], references: [id])
  subtotal       Decimal
  total          Decimal
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  items          OrderItem[]
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id])
  productId   String?
  productName String
  sku         String?
  price       Decimal
  quantity    Int
  lineTotal   Decimal
}

model CustomerInfo {
  id       String  @id @default(cuid())
  fullName String
  email    String?
  phone    String  @unique
  whatsapp String?

  orders Order[]
}

model Address {
  id         String  @id @default(cuid())
  line1      String
  line2      String?
  city       String
  district   String?
  postalCode String?
  country    String

  orders Order[]
}
