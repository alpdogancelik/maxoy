# Production Environment Variables
# Copy this to .env.production and fill in with actual values

# Database
DATABASE_URL="postgresql://maxoy:STRONG_PASSWORD@db:5432/maxoy?schema=public"
POSTGRES_USER="maxoy"
POSTGRES_PASSWORD="STRONG_PASSWORD_HERE"
POSTGRES_DB="maxoy"
POSTGRES_PORT="5432"

# Admin credentials
ADMIN_EMAIL="admin@yourdomain.com"
ADMIN_PASSWORD="STRONG_PASSWORD_HERE"

# Media Storage (S3/R2 - optional)
S3_ENDPOINT="https://your-endpoint.r2.cloudflarestorage.com"
S3_REGION="auto"
S3_ACCESS_KEY_ID="your_access_key"
S3_SECRET_ACCESS_KEY="your_secret_key"
S3_BUCKET="maxoy-media-prod"
MEDIA_PUBLIC_BASE_URL="https://media.yourdomain.com"
NEXT_PUBLIC_MEDIA_BASE_URL="https://media.yourdomain.com"

# Application
APP_PORT="3000"
NODE_ENV="production"
NEXT_TELEMETRY_DISABLED="1"

# Nginx
NGINX_HTTP_PORT="80"
NGINX_HTTPS_PORT="443"

# Docker image (for GitHub Actions)
GITHUB_REPOSITORY="yourorg/maxoy"
IMAGE_TAG="latest"
